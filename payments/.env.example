# Local/sandbox example only. Never commit a real key or copy it into this file.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ADMIN_API_TOKEN=replace_with_a_long_random_admin_token
PUBLIC_SITE_URL=http://localhost:4242
PORT=4242
ORDER_DATA_DIR=./data
# Production only: injected by the managed PostgreSQL provider.
# DATABASE_URL=postgresql://...
# Stripe Projects currently exposes the Render database as ORDERS_DB_URL.
# ORDERS_DB_URL=postgresql://...

# Production remains blocked unless this is deliberately changed to true.
ALLOW_LIVE_PAYMENTS=false

# Server-side GA4 events. Keep the API secret in the server environment only.
GA4_MEASUREMENT_ID=G-0DJKT6VHVL
GA4_API_SECRET=replace_with_measurement_protocol_secret
GA4_SERVER_EVENTS_ENABLED=true
GA4_VALIDATION_MODE=false

# Prepared but deliberately disabled until separate privacy/policy approval.
ENHANCED_CONVERSIONS_ENABLED=false

# Consented checkout-recovery email. Stripe Projects injects the first name.
AGENTMAIL_AGENTMAIL_API_KEY=am_replace_me
# No SMS provider or SMS recovery variable is configured.
